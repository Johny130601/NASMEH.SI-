# --- Database (AGENTS.md §6) ---
# Local dev: db service published by docker-compose.override.yml on host port
# 5543 (5432 avoided on purpose — often taken by a local Postgres install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5543/nasmeh"
# In docker compose, the app service overrides this to postgresql://postgres:postgres@db:5432/nasmeh

# --- App ---
# Host port published by the app container
PORT=3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js ---
AUTH_SECRET="generate-a-long-random-string-here"
AUTH_URL="http://localhost:3000"
# Seed-only: password for the initial ADMIN user (change for any real deploy)
SEED_ADMIN_EMAIL="admin@nasmeh.si"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Stripe (phase 3; endpoints /api/webhooks/stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_KLARNA_ENABLED="false"

# --- PayPal (phase 3; /api/webhooks/paypal) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox"

# --- Transactional email (local dev: mailpit from `compose --profile tools up`) ---
# Host port 11025 (1025 avoided — often taken by another local mailpit)
SMTP_HOST="localhost"
SMTP_PORT=11025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Nasmeh.si <info@nasmeh.si>"

# --- Cloudflare Turnstile (bot protection, spec §3.6) ---
# Without keys the guard fails closed in production and allows in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# e2e-only bypass token — active ONLY in test mode. NEVER set in production.
TURNSTILE_TEST_TOKEN=""
# e2e harness flag (Playwright sets this; marks the process as test mode for the
# Turnstile bypass because Next.js inlines NODE_ENV=production into builds).
# NEVER set in production.
NASMEH_E2E=""

# --- Jobs (host cron → /api/jobs/daily) ---
JOBS_SECRET="generate-a-long-random-string-here-too"
