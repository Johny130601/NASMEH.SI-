# --- Database (AGENTS.md §6) ---
# Local dev: db service published by docker-compose.override.yml on host port
# 5543 (5432 avoided on purpose — often taken by a local Postgres install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5543/nasmeh"
# In docker compose, the app service overrides this to postgresql://postgres:postgres@db:5432/nasmeh

# --- App ---
# Host port published by the app container (loopback only; the reverse proxy
# reaches the container over the proxy network, see docker-compose.proxy.yml)
PORT=3000
# Public origin: canonicals, sitemap, mail and coupon links. Read at request
# time, so the same image serves staging and production. https://nasmeh.si on the host.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Name of the host's existing reverse-proxy docker network (docker-compose.proxy.yml)
PROXY_NETWORK="proxy"

# --- Auth.js ---
AUTH_SECRET="generate-a-long-random-string-here"
AUTH_URL="http://localhost:3000"
# First start of an empty database creates the OWNER account from these two
# (lib/bootstrap/owner.ts; the dev seed uses them too). Production refuses the
# example password. Sign in, enrol the second factor, then remove the password.
SEED_ADMIN_EMAIL="admin@nasmeh.si"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Stripe (phase 3; endpoints /api/webhooks/stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_KLARNA_ENABLED="false"

# --- PayPal (phase 3; /api/webhooks/paypal) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox"

# --- Transactional email (local dev: mailpit from `compose --profile tools up`) ---
# Host port 11025 (1025 avoided — often taken by another local mailpit)
SMTP_HOST="localhost"
SMTP_PORT=11025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Nasmeh.si <info@nasmeh.si>"

# --- Cloudflare Turnstile (bot protection, spec §3.6) ---
# Without keys the guard fails closed in production and allows in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# e2e-only bypass token — active ONLY in test mode. NEVER set in production.
TURNSTILE_TEST_TOKEN=""
# e2e harness flag (Playwright sets this; marks the process as test mode for the
# Turnstile bypass because Next.js inlines NODE_ENV=production into builds).
# NEVER set in production.
NASMEH_E2E=""

# --- Jobs (host cron → /api/jobs/daily) ---
JOBS_SECRET="generate-a-long-random-string-here-too"

# --- Content-Security-Policy (Phase 9 step 1) ---
# "false" sends Content-Security-Policy-Report-Only (violations are logged by /api/csp-report);
# "true" enforces the same policy. Keep "false" until a full browser run stays clean.
CSP_ENFORCE="false"
